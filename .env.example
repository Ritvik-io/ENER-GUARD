# SafeScout MINE-ENERGY Environment Configuration

# Server Settings
DEBUG=false
APP_NAME="SafeScout MINE-ENERGY"

# Serial Communication Ports
# Linux / Raspberry Pi:
ESP32_SERIAL_PORT=/dev/ttyUSB1
LD19_SERIAL_PORT=/dev/ttyUSB0
# Windows alternative:
# ESP32_SERIAL_PORT=COM3
# LD19_SERIAL_PORT=COM4

ESP32_BAUD_RATE=115200
LD19_BAUD_RATE=230400

# Camera Stream URL
ESP32_CAM_STREAM_URL=http://192.168.4.1/stream
ESP32_CAM_CAPTURE_URL=http://192.168.4.1/capture

# Simulation Mode Toggle (set true to force synthetic physics without hardware)
FORCE_SIMULATION_MODE=false

# Economic Tariffs (Indian Industrial Standards)
ELECTRICITY_TARIFF_INR_PER_KWH=8.50
WATER_TARIFF_INR_PER_M3=45.00
COMPRESSOR_SPECIFIC_POWER_KW_PER_CFM=0.20
PUMP_SPECIFIC_ENERGY_KWH_PER_M3=0.65

